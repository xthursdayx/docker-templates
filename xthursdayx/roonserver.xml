<?xml version="1.0"?>
<Container version="2">
  <Name>RoonServer</Name>
  <Repository>ghcr.io/roonlabs/roonserver:latest</Repository>
  <Registry>https://github.com/roonlabs/roon-docker/pkgs/container/roonserver</Registry>
  <Network>host</Network>
  <MyIP/>
  <MyMAC/>
  <Shell>bash</Shell>
  <Privileged>true</Privileged>
  <Support>https://github.com/RoonLabs/roon-docker/issues</Support>
  <Project>https://github.com/RoonLabs/roon-docker</Project>
  <ReadMe/>
  <Overview>Docker image for running Roon Server. Roon Server is a software package that provides a &#x201C;headless&#x201D; version of Roon. It will be the brain of your music system, managing your music files, streaming services, and your audio devices. Roon Server is used in conjunction with Roon or Roon Remote, both of which provide control functionality.</Overview>
  <Category>MediaServer:Music</Category>
  <WebUI/>
  <TemplateURL>https://raw.githubusercontent.com/xthursdayx/docker-templates/master/xthursdayx/roonserver.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/xthursdayx/docker-templates/master/xthursdayx/images/roon-icon.png</Icon>
  <ExtraParams>--restart unless-stopped --log-opt max-size=50m --log-opt max-file=3</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1790453835</DateInstalled>
  <DonateText>&#x200B; If you appreciate my work please consider buying me a coffee, cheers!&#xA0;&#x1F601;</DonateText>
  <DonateLink>https://www.buymeacoffee.com/xthursdayx</DonateLink>
  <Requires/>
  <Config Name="Music" Target="/music" Default="" Mode="rw" Description="Default music folder" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/data/media/music/</Config>
  <Config Name="Backup" Target="/backup" Default="" Mode="rw" Description="Roon backup destination (optional). Configure in Settings &amp;gt; Backups." Type="Path" Display="always" Required="false" Mask="false">/mnt/user/data/backup/roon_backup/</Config>
  <Config Name="Roon ARC" Target="34885" Default="34885" Mode="tcp" Description="Remote Listening Port" Type="Port" Display="always" Required="false" Mask="false">34885</Config>
  <Config Name="ROON_INSTALL_BRANCH" Target="ROON_INSTALL_BRANCH" Default="production" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">production</Config>
  <Config Name="TZ" Target="TZ" Default="America/New_York" Mode="" Description="" Type="Variable" Display="always" Required="true" Mask="false">America/Toronto</Config>
  <Config Name="Data" Target="/Roon" Default="/mnt/cache/appdata/roonserver/" Mode="rw" Description="RoonServer state &#x2014; database, settings, identity, and application binaries. Must be writable and persistent." Type="Path" Display="advanced" Required="true" Mask="false">/mnt/cache/appdata/roonserver/</Config>
</Container>
